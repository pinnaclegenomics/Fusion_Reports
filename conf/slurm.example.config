// Copy/edit this file for your institution, then use -c your-site.config.
process {
    executor = 'slurm'
    queue = 'REPLACE_WITH_YOUR_PARTITION'
    cpus = 2
    memory = '8 GB'
    time = '8h'
    // clusterOptions = '--account=YOUR_ACCOUNT'
    // beforeScript = 'module load YOUR_PYTHON_MODULE YOUR_IGV_MODULE'
}
