manifest {
    name = 'cab/fusion-reports'
    description = 'CAB fusion HTML/PDF reports and IGV review from existing caller outputs'
    version = '1.0.0'
    nextflowVersion = '>=24.10.0'
}
params {
    inputs = null
    outdir = 'results_fusion'
    top_n = 5
    igv_top_n = 5
    report_config = null
    logo = null
    references = null
    bam_dir = null
    bam_pattern = null
    igv_genome = null
    igv_flank = 250
    igv_command = null
    tool_background = null
    python = 'python3'
    help = false
}
process {
    executor = 'local'
    cpus = 2
    memory = '8 GB'
    time = '8h'
    errorStrategy = 'terminate'
}
profiles {
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    slurm {
        process.executor = 'slurm'
    }
}
